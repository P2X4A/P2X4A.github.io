---
import { Image } from "astro:assets";
import portfolioData from "@config/portfolioData.json";
import SectionHeading from "@components/Sections/Global/SectionHeading.astro";
import { Reveal } from "@components/ui/reveal";
import avatarImage from "../../../assets/images/about-avatar.png";
---

<Reveal as="section" aria-labelledby="about-heading" class="flex flex-col gap-6 md:gap-8">
  <SectionHeading id="about-heading" title="Sobre Mí" />

  <div class="grid grid-cols-1 gap-8 md:grid-cols-[1fr_300px] lg:grid-cols-[1fr_400px]">
    <div class="flex flex-col gap-6 text-base text-muted-foreground sm:text-lg">
      <div class="flex flex-col gap-4">
        {portfolioData.profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div>
        <a href="/about/" class="pixel-btn pixel-btn--blue px-5 py-4 text-sm uppercase sm:text-base inline-block">
          Ver Presentación Completa
        </a>
      </div>
    </div>

    <aside class="flex flex-col gap-6">
      <div class="border-4 border-muted p-2 bg-muted/20">
        <Image
          src={avatarImage}
          alt="Avatar de Sergio Parra"
          class="w-full h-auto object-cover rounded-sm border-2 border-foreground/20"
        />
      </div>

      <div class="flex flex-col gap-4 p-4 md:p-6 rounded-lg bg-muted text-sm sm:text-base">
        <h3 class="text-lg font-bold text-foreground">Tech Stack</h3>
        <ul class="flex flex-col gap-3">
          <li class="flex justify-between items-center">
            <span>Java / POO</span>
            <span class="text-success">Nvl. Intermedio</span>
          </li>
          <li class="flex justify-between items-center">
            <span>SQL / BD Relacionales</span>
            <span class="text-success">Nvl. Aprendiz</span>
          </li>
          <li class="flex justify-between items-center">
            <span>Infraestructura TI</span>
            <span class="text-success">Nvl. Intermedio</span>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</Reveal>