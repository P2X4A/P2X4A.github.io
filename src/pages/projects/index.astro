---
// Projects listing (/projects/). Thin route shell: owns BaseLayout + SEO and composes the Figma
// "project-log-overview" frame (node 72:7) — the ProjectsHero panel + the shared CardGrid, fed from
// the `projects` collection (sorted by `order`, drafts dropped). Same `.site-container` shell/rhythm
// as index.astro & about.astro. This is the page the header nav's PROJECTS link points at.
import CardGrid from "@components/Sections/Global/CardGrid.astro";
import ProjectsHero from "@components/Sections/Project/ProjectsHero.astro";
import { PixelPanel } from "@components/ui/pixel-panel";
import siteData from "@config/siteData.json";
import { toProjectCard } from "@js/projectCards";
import { projectCategories } from "@js/projectCategories";
import { getSortedProjects } from "@js/projectData";
import BaseLayout from "@layouts/BaseLayout.astro";

const projects = await getSortedProjects();
const cards = projects.map(toProjectCard);
const counts = new Map<string, number>(projects.map((p) => [p.data.category, 0]));
for (const p of projects) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
---

<BaseLayout
  title={`Evidencias -${siteData.name}`}
  description="The quest archive: full-stack builds, migrations, and terminal prototypes — every module cataloged with its stack, status, and source notes."
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <ProjectsHero />
    <section aria-labelledby="evidence-categories-heading" class="flex flex-col gap-6">
      <h2 id="evidence-categories-heading" class="h3 text-info">Evidencias por sección</h2>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          projectCategories.map((cat) => (
            <li>
              <a href={`/projects/${cat.slug}/`} class="block h-full">
                <PixelPanel class="flex h-full flex-col gap-3 p-6 transition-transform hover:-translate-y-1">
                  <span class="font-display text-info text-xs uppercase">{cat.tagline}</span>
                  <span class="h3">{cat.label}</span>
                  <span class="text-muted-foreground text-sm leading-relaxed">{cat.intro}</span>
                  <span class="text-muted-foreground mt-auto text-xs font-bold tracking-wide uppercase">
                    {counts.get(cat.slug) ?? 0} evidencia(s) — Ver sección
                  </span>
                </PixelPanel>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <CardGrid headingId="all-systems-heading" title="Todas las evidencias" items={cards} />
  </div>
</BaseLayout>
