# Copy to `.env` and fill in. On a host, set the same variables in its build environment.

# Your production domain. Feeds canonical + OG URLs, JSON-LD, the sitemap, robots.txt and
# llms.txt — setting it once fixes all of them. The Pages workflow sets it explicitly (see
# .github/workflows/deploy.yml); a local build falls back to the default in astro.config.mjs.
SITE_URL=https://p2x4a.github.io

# Only needed on hosts that aren't Netlify or Vercel, whose own build variables the gate already
# reads. Set this to "production" in your production build environment — and nowhere else, or
# preview deploys will start failing on the placeholder too.
# DEPLOY_ENV=production

# --- Contact form -----------------------------------------------------------------------------
# There are NO server secrets on this project: the site is 100% static (GitHub Pages), so nothing
# runs on a server and there is nothing to keep secret. The contact form validates in the browser
# and opens a prefilled mailto: to the address in src/config/siteData.json.ts (siteData.author.email)
# — change it there, not here.
